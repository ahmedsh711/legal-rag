// Grafana Alloy ships the logs of this project's containers to Loki.
// Labels stay few and bounded (container, service): request_id and trace_id stay INSIDE the
// JSON log line and are filtered at query time ({container="legal-rag-api-1"} | json | ...),
// because a label per request would explode Loki's index exactly like it would Prometheus'.
discovery.docker "project" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=legal-rag"]
  }
}

discovery.relabel "project" {
  targets = discovery.docker.project.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "project" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.project.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
