# Copy to .env and fill in. Never commit .env.

# --- LLM generation + judge (OpenAI-compatible) ---
LLM_BACKEND=openrouter            # openrouter | vllm
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-72b-instruct
JUDGE_MODEL=anthropic/claude-sonnet-5-5
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ

# --- Jev decision model ---
DECIDER_BACKEND=jev               # jev | local
TYPESAFE_API_KEY=                 # optional; if empty, Jev is called through OpenRouter
JEV_MODEL=jev-1.13.0

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_ALIAS=articles

# --- Infra ---
REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000
POSTGRES_USER=legalrag
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
ALERT_WEBHOOK_URL=                # Discord/Slack incoming webhook for Alertmanager
