# Copy to .env and fill in. Never commit .env.

# --- LLM generation + judge (OpenAI-compatible) ---
LLM_BACKEND=openrouter            # openrouter | gemini | vllm
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-235b-a22b-2507
LLM_PRICE_IN_PER_M=0.09           # USD per million tokens (0 on a free tier)
LLM_PRICE_OUT_PER_M=0.55
# Gemini API (free tier, OpenAI-compatible endpoint): https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# RAGAS / LLM judge: endpoint (openrouter | gemini), model, embedding model for answer relevancy
JUDGE_BACKEND=openrouter
JUDGE_MODEL=anthropic/claude-haiku-5.5
JUDGE_EMBEDDING_MODEL=baai/bge-m3
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ

# --- Decider: rerank + "can we answer?" gate ---
DECIDER_BACKEND=none              # none | jev (via OpenRouter, same key) | local (bge-reranker-v2-m3)
JEV_MODEL=jev-1.13
GATE_THRESHOLD=0.75
# env: knobs above; mlflow: runtime knobs from models:/legal-rag-config@production
CONFIG_SOURCE=env

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=9a0624b896d81da7492a910ffa53731274b6cf3d
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_ALIAS=articles

# --- Infra ---
API_HOST_PORT=8000                # host port for the API container (change if 8000 is taken)
REDIS_URL=redis://127.0.0.1:6379/0
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
POSTGRES_USER=legalrag
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
ALERT_WEBHOOK_URL=                # Discord/Slack incoming webhook for Alertmanager

# Only if your machine inspects HTTPS (antivirus / corporate proxy): path to its root CA (PEM)
LOCAL_CA_CERT=
